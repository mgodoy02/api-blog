# =====================================================
#  Actividad 8 - API Blog
#  Pruebas con REST Client (VS Code)
#  Arrancar antes el servidor: pnpm dev
# =====================================================

@baseUrl = http://localhost:3000/api


# -----------------------------------------------------
#  AUTORES
# -----------------------------------------------------

### Obtener todos los autores
GET {{baseUrl}}/autores

### Obtener un autor por id
GET {{baseUrl}}/autores/1

### Obtener un autor que no existe → 404
GET {{baseUrl}}/autores/999

### Crear un autor → 201
POST {{baseUrl}}/autores
Content-Type: application/json

{
  "nombre": "Juan Álvarez",
  "email": "juan@mail.com",
  "imagen": "https://i.pravatar.cc/150?img=3"
}

### Crear un autor sin email → 400
POST {{baseUrl}}/autores
Content-Type: application/json

{
  "nombre": "Sin Email"
}

### Crear un autor con email repetido → 500 (UNIQUE)
POST {{baseUrl}}/autores
Content-Type: application/json

{
  "nombre": "Email Repetido",
  "email": "juan@mail.com"
}


# -----------------------------------------------------
#  POSTS
#  Cada post se devuelve con los datos completos de su autor
# -----------------------------------------------------

### Obtener todos los posts
GET {{baseUrl}}/posts

### Obtener un post por id
GET {{baseUrl}}/posts/1

### Obtener un post que no existe → 404
GET {{baseUrl}}/posts/999

### Crear un post → 201
POST {{baseUrl}}/posts
Content-Type: application/json

{
  "titulo": "Introducción al Máster Full Stack",
  "descripcion": "En este post explicamos el temario del Máster Full Stack.",
  "categoria": "Máster Full Stack",
  "autor_id": 2
}

### Crear un post sin categoría → 400
POST {{baseUrl}}/posts
Content-Type: application/json

{
  "titulo": "Incompleto",
  "descripcion": "Falta la categoría",
  "autor_id": 1
}

### Crear un post con un autor que no existe → 400
POST {{baseUrl}}/posts
Content-Type: application/json

{
  "titulo": "Huérfano",
  "descripcion": "Este autor no existe",
  "categoria": "General",
  "autor_id": 999
}


# -----------------------------------------------------
#  POSTS DE UN AUTOR
# -----------------------------------------------------

### Obtener los posts de un autor
GET {{baseUrl}}/autores/1/posts

### Obtener los posts de un autor que no existe → 404
GET {{baseUrl}}/autores/999/posts

### Obtener los posts de un autor sin posts → []
GET {{baseUrl}}/autores/3/posts